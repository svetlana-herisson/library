<%- include('../port/layout-start', {title: title}) %>
<%- include('../port/menu') %>


<h1><%= title %></h1>
<!-- делаем динамический контент -->

<a class="btn btn-sm btn-primary" href="books/create">Добавить запись</a>

    <% if(todos.length) { %>
    <!-- проверяем есть ли элементы в массиве-->
        <table class="table table-striped table-sm  mt-3">
            <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Заголовок</th>
                <th scope="col"></th>
            </tr>
            </thead>
            <tbody>
    
                <% todos.map((el, idx) => {  %> 
                    <!-- получаем текующую запись и ее индекс -->
                    <tr>
                        <th scope="row"><%= idx +1 %></th> 
                        <!-- выводим текущий индекс плюс 1 -->
                        <td><%= el.title %></td>
                        <td class="text-right">
                            <a class="btn btn-sm btn-success" href="/books/<%= el.id %>"> <!-- динамические ID -->

                                <i class="fa fa-eye" aria-hidden="true"></i>
                            </a>
                            <a class="btn btn-sm btn-primary" href="/books/update/<%= el.id %>"> <!-- динамические ID -->
                                <i class="fa fa-pencil" aria-hidden="true"></i>
                            </a>
                            <form action="/books/delete/<%= el.id %>" method="POST" class="d-inline">
                                <button class="btn btn-sm btn-danger">
                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                <% }) %> 
                <!-- делаем повторяющийся объект -->
    
            </tbody>
        </table>

    <% } else { %>   
        <h3 class="mt-5">Записей пока нет</h3>
    <% } %>    

    <!-- выводим, если нет записей -->
    



<%- include('../port/layout-end') %>
