<%- include('../port/layout-start', {title: title}) %>
<%- include('../port/menu') %>
<!--  подключаем шаблоны, поднимаясь на уровень выше (../) -->
<h1><%= title %></h1>
<!-- делаем динамический title -->
<div class="row">
    <div class="col-sm-8">
        <div class="card">
            <div class="card-body">

                <h5 class="card-title"><%= books.title %></h5>
                <p class="card-text">Номер книги: <%= books.id %></p> 
                <p class="card-text">Описание книги: <%= books.description %></p> 
                <p class="card-text">Автор книги: <%= books.authors %>
                <p class="card-text">Любимая книга: <%= books.favorite %>

                

                <div class="text-right">
                    <a class="btn btn-sm btn-primary" href="/books/update/<%= books.id %>"> <!-- указываем динамический ID  -->
                        <i class="fa fa-pencil" aria-hidden="true"></i>
                    </a>
                    <form action="/books/delete/<%= books.id %>" method="POST" class="d-inline"> <!-- указываем динамический ID  -->
                        <button class="btn btn-sm btn-danger">
                            <i class="fa fa-trash" aria-hidden="true"></i>
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

<%- include('../port/layout-end') %>